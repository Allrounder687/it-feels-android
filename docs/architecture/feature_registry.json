          "components": ["AudioPlayerHandler", "NewAudioScrubber", "_DesktopTrackScrubber"],
          "capabilities": ["clamp_target", "drag_buffering", "seek_on_release"]
        },
        "deterministic_shuffle": {
          "id": "PLBK-003",
