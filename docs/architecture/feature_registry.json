          "id": "PLBK-005",
          "name": "10-Band Graphic Equalizer & Loudness Normalization",
          "supported": true,
          "components": ["EqualizerService", "NewEqualizerSheet"],
          "capabilities": ["10_bands", "bass_boost", "treble_boost", "preamp_gain", "ebu_r128_loudnorm", "10_presets"]
