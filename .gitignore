# ===============================
# Comprehensive .gitignore for Flutter/Dart Project
# ===============================

# ===============================
# General / OS-specific
# ===============================
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ===============================
# Editor / IDE Specifics
# ===============================
*.swp
*.swo
*.backup
*.log

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/
local.properties
*.temp

# ===============================
# Build Output Directories
# ===============================
/build/
/bin/
*.dSYM/
*.apk
*.aab
*.jar
*.war
*.nar
*.exe
*.out

# ===============================
# Flutter / Dart Specifics
# ===============================
.dart_tool/
.build/
.pub-cache/
.pub/
.flutter-plugins-dependencies
/flutter_plugins.dart
/gen_l10n/
/ios/Flutter/.last_build_id
/test_coverage/
/coverage/

# Pub spec lock should NOT be committed usually, but keep it for reproducibility if needed
# pubspec.lock

# ===============================
# Android Specifics
# ===============================
/android/app/build/
/android/.gradle/
/gradle.properties
/gradlew
/gradlew.bat
!/android/gradle/wrapper/gradle-wrapper.jar
/kotlin/

# ===============================
# iOS Specifics
# ===============================
/ios/Flutter/Flutter.framework
/ios/Flutter/_framework
/ios/Pods
/ios/Podfiles
/ios/workspace.xcworkspace
/ios/*.xccheckout
/ios/*.xcuserstate
/ios/Generated.xcconfig

# ===============================
# Python Specifics (for our script)
# ===============================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory/setup.py
.tox/
.nox/
.coverage
.Cython.env
Cython.d
.hypothesis/
.pytest_cache/
pytest_report.html

# ===============================
# Node.js / Frontend (if applicable)
# ===============================
/node_modules/
/npm-debug.log
yarn-error.log
.pnpm-debug.log
.dist/
.prettiercache
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
next-build/
.next/
!/.env.local

# ===============================
# Test Artifacts
# ===============================
*covprof
coverage/
unittest-results.xml
test-results.xml
*.profraw
*.profdata

# ===============================
# Your Project-Specific Ignored Files
# ===============================
# Upload tracking files
.uploaded_apks.json
*.uploaded_apps.json

# Auto-generated files
apks_to_drive.py
upload_apks.bat
requirements.txt

# Your personal configs
.settings/
.config/
.secrets/

# Large binary or generated assets
/assets/generated/
/assets/downloads/
/assets/cache/

# ===============================
# Cloudflare Worker Specifics
# ===============================
.wrangler/
.dev.vars

